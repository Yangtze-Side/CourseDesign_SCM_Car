  84          /**
  85           * @brief Transform car_speed to motor_speed.
  86           * @note  When motor speed is determined by car speed.
  87           * 
  88           * @param cs Car speed
  89           * @param ms Motor speed
  90           */
  91          static void Car_SpeedTransform(CarSpeed_t *cs, MotorSpeed_t *ms)
  92          {
  93   1          // Ensure that cs.x + cs.y <= 80
  94   1          if ( ABS(cs->x) + ABS(cs->y) > 80.0f )
  95   1          {
  96   2              cs->x = (int16_t)(cs->x / (ABS(cs->x) + ABS(cs->y)) * 80.0f );
  97   2              cs->y = ( cs->y < 0.0f ? (ABS(cs->x) - 80.0f) : (80.0f - ABS(cs->x)) );
  98   2          }
  99   1      
 100   1          // Ensure that cs.x + cs.y + cs.w < 100
 101   1          if (ABS(cs->w) > 20.0f)
 102   1          {
 103   2              float temp = 100.0f - ABS(cs->x) - ABS(cs->y);
 104   2              if (ABS(cs->w) > temp)
 105   2              {
 106   3                  if (cs->w < 0) temp = -temp;
 107   3                  cs->w = temp;
 108   3              }
 109   2          }
 110   1      
 111   1          ms->A = cs->y - cs->x - cs->w;
 112   1          ms->B = cs->y + cs->x + cs->w;
 113   1          ms->C = cs->y + cs->x - cs->w;
 114   1          ms->D = cs->y - cs->x + cs->w;
 115   1      }
