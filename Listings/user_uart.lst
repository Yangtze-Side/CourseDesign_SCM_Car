  17   1              {
  18   2                      case UART1: SBUF  = *(send->Buf); break;
  19   2                      case UART2: S2BUF = *(send->Buf); break;
  20   2                      case UART3: S3BUF = *(send->Buf); break;
  21   2                      case UART4: S4BUF = *(send->Buf); break;
  22   2                      default: break;
  23   2              }
  24   1              send->Cnt = 0;
  25   1              send->Size = txSize;
  26   1      }
