  50           * 
  51           * @param Width Pulse width.
  52           */
  53          void User_PWMA_SetWidth(u16 Width)
C51 COMPILER V9.60.7.0   USER_PWM                                                          11/11/2025 20:04:23 PAGE 2   

  54          {
  55   1          if (Width >= 2000)
