   4          /**
   5           * @brief Initialize PWM periperal. Determined by user.
   6           * 
   7           */
   8          void User_PWM_Init(void)
   9          {
  10   1          PWMA_Pin = 0;
  11   1          PWMB_Pin = 0;
  12   1          PWMC_Pin = 0;
  13   1          PWMD_Pin = 0;
  14   1      
  15   1          PWM_Disable();
  16   1      
  17   1          PWM_CLK_SYSCLK();
  18   1          PWM_SetClockDivider(PWM_CLK_DIVIDER);       //设置系统时钟的分频值 [SYSCLK/(n+1)]
  19   1          PWM_SetCounter(PWM_PERIOD);                 //使能PWM周期值
  20   1      
  21   1          PWM_C2_SwitchP27();                 //设置PWM2端口: PWM2 (P2.7)
  22   1          PWM_InitialC2Low();                 //设置PWM2通道初始电平为低电平
  23   1          PWM_SetC2T1Point(1);                //使能PWM2翻转点1的计数值
  24   1          PWM_SetC2T2Point(0);                //使能PWM2翻转点2的计数值
  25   1          PWM_DisableC2Output();              //不使能PWM2通道输出
  26   1      
  27   1          PWM_C3_SwitchP21();                 //设置PWM3端口: PWM3 (P2.1)
  28   1          PWM_InitialC3Low();                 //设置PWM3通道初始电平为低电平
  29   1          PWM_SetC3T1Point(1);                //使能PWM3翻转点1的计数值
  30   1          PWM_SetC3T2Point(0);                //使能PWM3翻转点2的计数值
  31   1          PWM_DisableC3Output();              //不使能PWM3通道输出
  32   1      
  33   1          PWM_C4_SwitchP22();                 //设置PWM4端口: PWM4 (P2.2)
  34   1          PWM_InitialC4Low();                 //设置PWM4通道初始电平为低电平
  35   1          PWM_SetC4T1Point(1);                //使能PWM4翻转点1的计数值
  36   1          PWM_SetC4T2Point(0);                //使能PWM4翻转点2的计数值
  37   1          PWM_DisableC4Output();              //不使能PWM4通道输出
  38   1      
  39   1          PWM_C5_SwitchP23();                 //设置PWM5端口: PWM5 (P2.3)
  40   1          PWM_InitialC5Low();                 //设置PWM5通道初始电平为低电平
  41   1          PWM_SetC5T1Point(1);                //使能PWM5翻转点1的计数值
  42   1          PWM_SetC5T2Point(0);                //使能PWM5翻转点2的计数值
  43   1          PWM_DisableC5Output();              //不使能PWM5通道输出
  44   1      
  45   1          PWM_Enable();
  46   1      }
